# Copy to .env inside backend/; all settings have safe local defaults.
HR_APP_ENV=development
HR_LOG_LEVEL=INFO
# JSON array of browser origins. The Vite development proxy works without CORS.
HR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Absolute path or a path relative to backend/. Original CSV and normalized JSONL stay local.
HR_DATASET_STORAGE_DIR=runtime/datasets
HR_MAX_UPLOAD_BYTES=52428800
HR_MAX_ROWS=250000
HR_MAX_COLUMNS=200
HR_PREVIEW_ROWS=20
# Per-process Inductive Miner limits; exact DFG/variants still run for larger logs.
HR_INDUCTIVE_MAX_EVENTS=50000
HR_INDUCTIVE_MAX_ACTIVITIES=100
